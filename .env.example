# Shared
BRIDGE_TOKEN=change-this-bridge-token
ADMIN_TOKEN=change-this-admin-token

# Backend
DATABASE_URL=postgresql+psycopg://mcserver:mcserver@postgres:5432/mcserver
SERVER_NAME=main
AI_NAME=da real qoque
AI_TRIGGER=@Guide
# Use mock for offline testing.
# LLM_PROVIDER=mock

# Groq free API / GroqCloud. Create a key at https://console.groq.com/keys.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant

# Later local Ollama option:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2:3b

# Discord bot
DISCORD_TOKEN=
DISCORD_GUILD_ID=
BACKEND_URL=http://backend:8000
DASHBOARD_PUBLIC_URL=http://localhost:5173
DISCORD_ANALYST_CHANNEL_ID=
ANALYST_DAILY_HOUR=21
ANALYST_TIMEZONE=Asia/Kuala_Lumpur

# Dashboard
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/dashboard
VITE_ADMIN_TOKEN=change-this-admin-token
